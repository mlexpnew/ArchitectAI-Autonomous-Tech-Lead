# ==========================================================
# ArchitectAI - Autonomous Tech Lead
# Environment Configuration
# ==========================================================

# ==========================================================
# LLM Provider Configuration
# Supported options: groq, gemini, openai, ollama, mock
# ==========================================================

LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini Configuration (Optional)
GOOGLE_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Testing & Mock Mode (true for offline/credential-less test runs)
MOCK_LLM=false

# Model Hyperparameters
MODEL_TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=8192


# ==========================================================
# Tavily Search API
# ==========================================================

TAVILY_API_KEY=your_tavily_api_key


# ==========================================================
# Application Settings
# ==========================================================

APP_NAME=ArchitectAI
APP_VERSION=1.0.0
APP_ENV=development

DEBUG=True

LOG_LEVEL=INFO


# ==========================================================
# Streamlit
# ==========================================================

STREAMLIT_SERVER_PORT=8501


# ==========================================================
# ChromaDB
# ==========================================================

CHROMA_DB_PATH=./data/chroma_db


# ==========================================================
# Report Storage
# ==========================================================

REPORT_OUTPUT_DIR=./outputs/reports

DIAGRAM_OUTPUT_DIR=./outputs/diagrams

EXPORT_OUTPUT_DIR=./outputs/exports


# ==========================================================
# Retry Configuration
# ==========================================================

MAX_RETRIES=3

REQUEST_TIMEOUT=120


# ==========================================================
# Optional FastAPI Configuration
# ==========================================================

API_HOST=0.0.0.0

API_PORT=8000


# ==========================================================
# GitHub Integration (Optional)
# ==========================================================

GITHUB_TOKEN=your_github_personal_access_token


# ==========================================================
# Logging
# ==========================================================

LOG_FILE=logs/architect_ai.log